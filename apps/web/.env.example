# Akşama Ne Var? — every variable is optional. The app works on Vercel with none of them set:
# recipe import then uses the rule-based Turkish parser. Server-side only (no NEXT_PUBLIC_ prefix).
# Set them in Vercel → Project → Settings → Environment Variables, then redeploy.
# Locally: copy to .env.local.

# Which LLM reads captions: anthropic | gemini | none. Unset = every configured key, Gemini first,
# then Claude (the current production setup). anthropic = Claude only (recommended for production),
# gemini = Gemini only (dev/testing: free tier, see below), none = the rule parser only.
AI_PROVIDER=

# Smart import, tried first. Free key: https://aistudio.google.com/apikey
# Free-tier note: Google may use free-tier inputs to improve its products, and the free tier's
# limits aren't published (they change). Only the caption text and the source platform are sent —
# never names, emails, household data or anything stored.
GEMINI_API_KEY=

# Optional model override (default: gemini-3.1-flash-lite).
GEMINI_MODEL=

# Smart import fallback when Gemini is not set, over its quota, slow or returns invalid output.
# Uses claude-haiku-5-5 (paid per use).
ANTHROPIC_API_KEY=

# Full YouTube descriptions via the YouTube Data API v3; without it only the video title arrives.
YOUTUBE_API_KEY=
