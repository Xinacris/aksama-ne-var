{
  "name": "aksama-ne-var",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build -w @anv/web",
    "dev": "npm run dev -w @anv/web",
    "test:e2e": "npm run test:e2e -w @anv/web",
    "screenshots": "npm run screenshots -w @anv/web",
    "mobile": "npm exec -w @anv/mobile -- expo start",
    "apk": "npm run apk -w @anv/mobile --",
    "format": "prettier --write .",
    "recipes:validate": "npm run recipes:validate -w @anv/core --",
    "recipes:convert": "npm run recipes:convert -w @anv/core --",
    "recipes:generate": "npm run recipes:generate -w @anv/core --",
    "recipes:export": "npm run recipes:export -w @anv/core --"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  }
}
