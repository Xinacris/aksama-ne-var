{
  "name": "aksama-ne-var",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build -w @anv/web",
    "dev": "npm run dev -w @anv/web",
    "test:e2e": "npm run test:e2e -w @anv/web",
    "screenshots": "npm run screenshots -w @anv/web",
    "mobile": "npm run start -w @anv/mobile",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  },
  "engines": {
    "node": ">=24"
  }
}
