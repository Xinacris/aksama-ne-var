  "steps": [
   {
    "text": {
     "tr": "Yoğurdu, rendelenmiş zencefil, ezilmiş sarımsak, garam masala ve zerdeçalı bir kapta karıştır; tavuğu ekleyip iyice bulaştır.",
     "en": "In a bowl, mix the yoghurt, grated ginger, crushed garlic, garam masala and turmeric; add the chicken and coat it well."
    },
    "timerSeconds": null
   },
   {
    "text": {
     "tr": "Kabı kapatıp buzdolabında 4 saat beklet.",
     "en": "Cover the bowl and leave it in the fridge for 4 hours."
    },
    "timerSeconds": 14400
   },
   {
    "text": {
     "tr": "Tavuğu tavada tereyağının yarısıyla kenarları hafif kızarana kadar çevir, bir kenara al.",
     "en": "Sear the chicken in half the butter until the edges are lightly browned, then set it aside."
    },
    "timerSeconds": null
   },
   {
    "text": {
     "tr": "Soğanı ince doğrayıp kalan tereyağında 8 dakika kavur.",
     "en": "Fry the finely chopped onion in the rest of the butter for 8 minutes."
    },
    "timerSeconds": 480
   },
   {
    "text": {
     "tr": "Kimyonu ve toz kırmızı biberi ekleyip kokusu çıkana kadar çevir; domates püresini ve tuzu ekle, 10 dakika kısık ateşte pişir.",
     "en": "Add the cumin and paprika and stir until fragrant; add the passata and salt and simmer gently for 10 minutes."
    },
    "timerSeconds": 600
   },
   {
    "text": {
     "tr": "Tavuğu birikmiş suyuyla birlikte sosa ekle, kremayı gezdir ve 15 dakika kısık ateşte pişir.",
     "en": "Return the chicken with its juices to the sauce, stir in the cream and simmer gently for 15 minutes."
    },
    "timerSeconds": 900
   },
   {
    "text": {
     "tr": "Tuzunu ayarla, doğranmış kişnişle süsle ve pilav ya da naanla sıcak servis et.",
     "en": "Adjust the salt, scatter over the chopped coriander and serve hot with rice or naan."
    },
    "timerSeconds": null
   }
