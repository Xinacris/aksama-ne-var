  "steps": [
   {
    "text": {
     "tr": "Patatesi küp küp doğra, soğanı ve kerevizi küçük doğra. Dana füme eti tencerede orta ateşte 5 dakika kavur.",
     "en": "Cut the potato into cubes and finely chop the onion and celery. Fry the beef bacon in the pot over medium heat for 5 minutes."
    },
    "timerSeconds": 300
   },
   {
    "text": {
     "tr": "Tereyağını ekleyip soğan ve kerevizi yumuşayana kadar kavur.",
     "en": "Add the butter and cook the onion and celery until soft."
    },
    "timerSeconds": null
   },
   {
    "text": {
     "tr": "Unu serpip 1 dakika karıştır, ardından tavuk suyunu yavaş yavaş ekleyerek pürüzsüz bir sos oluştur.",
     "en": "Sprinkle in the flour and stir for 1 minute, then add the chicken stock slowly to make a smooth sauce."
    },
    "timerSeconds": 60
   },
   {
    "text": {
     "tr": "Patates küplerini ve defne yaprağını ekle, kısık ateşte 12 dakika pişir.",
     "en": "Add the potato cubes and bay leaf, and simmer gently for 12 minutes."
    },
    "timerSeconds": 720
   },
   {
    "text": {
     "tr": "Kum midyelerini ayrı bir tencerede, kapağı kapalı olarak açılana kadar pişir. Etlerini ayır, pişme suyunu süzüp çorbaya ekle.",
     "en": "Cook the clams in a separate pot, covered, until they open. Take the meat out, strain the cooking liquor and add it to the soup."
    },
    "timerSeconds": null
   },
   {
    "text": {
     "tr": "Sütü ve kremayı ekle, midyeleri de katıp kaynamasına izin vermeden kısık ateşte 5 dakika ısıt.",
     "en": "Stir in the milk and cream, add the clams, and heat gently for 5 minutes without letting it boil."
    },
    "timerSeconds": 300
   },
   {
    "text": {
     "tr": "Defne yaprağını çıkar, tuz ve karabiberle tatlandır, maydanozu serpip sıcak servis et.",
     "en": "Remove the bay leaf, season with salt and black pepper, scatter over the parsley and serve hot."
